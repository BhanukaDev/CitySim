.DS_Store

# Native libraries; build with native/*/build.sh after a fresh checkout.
native/*/bin/

# Downloaded CC0 textures; recreate with experiments/terrain/tools/fetch_textures.sh.
assets/textures/terrain/**/*.jpg
assets/textures/terrain/**/.gdignore
# What ThemeBaker makes from them (texture-array strips, preview swatches); recreate with fetch_textures.sh or
# Bake in the inspector. The strips' .import files are committed (they set up the texture-array import).
themes/*/baked/*.png
