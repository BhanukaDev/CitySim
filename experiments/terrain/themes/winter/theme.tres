[resource]
script = ExtResource("1_theme")
Id = "winter"
DisplayName = "Winter"
Description = "Snow everywhere: wind-scoured slopes show frozen grass and earth, rock keeps snow on its ledges, streams are frozen."
Material = SubResource("ShaderMaterial_theme")
Materials = Array[ExtResource("2_material")]([SubResource("mat_snow"), SubResource("mat_snow_rough"), SubResource("mat_grass_dry"), SubResource("mat_dirt"), SubResource("mat_gravel"), SubResource("mat_rock"), SubResource("mat_ice")])
Deposit = SubResource("slot_Deposit")
DepositHeavy = SubResource("slot_DepositHeavy")
Scour = SubResource("slot_Scour")
ScourHeavy = SubResource("slot_ScourHeavy")
ShoreFringe = SubResource("slot_ShoreFringe")
Shore = SubResource("slot_Shore")
StreamBank = SubResource("slot_StreamBank")
StreamBed = SubResource("slot_StreamBed")
Wet = SubResource("slot_Wet")
