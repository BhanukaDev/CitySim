<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <!-- The terrain package (addons/citysim_terrain) needs both: its generator is ~6x faster optimised, and its native
         erosion/water libraries are called through function pointers. -->
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CitySim</RootNamespace>
  </PropertyGroup>
</Project>
